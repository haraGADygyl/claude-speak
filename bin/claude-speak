#!/usr/bin/env bash
# claude-speak — control Claude Code's spoken replies.
#
#   claude-speak install         download the neural voice model (one time)
#   claude-speak [status]        show current settings
#   claude-speak on | off        toggle reading replies aloud
#   claude-speak stop            shut up right now
#   claude-speak test            speak a sample line
#   claude-speak read FILE       read a file aloud (- for stdin)
#   claude-speak voice af_bella  pick a voice
#   claude-speak voices          list every voice
#   claude-speak audition        hear the best English voices back to back
#   claude-speak speed 1.2       0.5 = slow, 1.0 = normal, 1.5 = fast
#   claude-speak max 4000        max characters read per reply
#   claude-speak mode queue      several terminals: queue | interrupt | drop
#   claude-speak queue           what is speaking and what is waiting
#   claude-speak restart         restart the TTS daemon
#   claude-speak log             tail the daemon log
#
# Replies are HELD by default — stashed with a notification, never spoken
# unless you ask. "claude-speak hold off" makes them read out automatically.
#
#   claude-speak pending         list what is waiting
#   claude-speak play            speak THIS terminal's replies, oldest first
#   claude-speak play all        speak every project's replies
#   claude-speak play <project>  speak one project's replies
#   claude-speak clear [all|project]  discard what is waiting
#   claude-speak hold off | on   auto-speak replies, or hold them
#   claude-speak sound <file>    ding when a reply lands (off | default | path)
#   claude-speak guard on|off|test  meeting guard: mic live = silence
set -uo pipefail

# Resolve symlinks so this works when linked into ~/.local/bin. Done by hand
# rather than with `readlink -f`, which older macOS does not have.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *)  SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
SCRIPTS="$(cd "$HERE/../scripts" && pwd)" || {
  echo "claude-speak: cannot find scripts/ next to $HERE" >&2; exit 1; }

DATA="${CLAUDE_SPEAK_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-speak}"
CFG="${CLAUDE_SPEAK_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-speak/config.json}"
HELD="$DATA/held.jsonl"
VENV_PY="$DATA/venv/bin/python"
SAY=(python3 "$SCRIPTS/say.py")

# All JSON goes through csconfig.py rather than jq. python3 is required by the
# rest of the plugin anyway, so this is one less system package to install —
# and it leaves cstext.DEFAULTS as the only place the defaults are written.
CS=(python3 "$SCRIPTS/csconfig.py")

# shellcheck source=../scripts/csheal.sh
. "$SCRIPTS/csheal.sh"
UNIT="$HOME/.config/systemd/user/claude-speak.service"
POINTER="$DATA/plugin-root"

# A plugin update moves the directory this script lives in, and both the PATH
# link and the systemd unit name the old one absolutely. The daemon then goes
# on launching the previous release's kokorod.py while the Stop hook runs the
# new code, so a shipped fix quietly never arrives. The hook records where the
# current copy is; repair towards that pointer, never towards whatever version
# is running this line — an old CLI fixing things to point at itself would pin
# the daemon to the release it came from. Silent unless it changed something.
heal() {
  local scripts rc
  scripts="$(cs_scripts_from_pointer "$POINTER")" || return 0

  cs_unit_sync "$UNIT" "$VENV_PY" "$scripts"; rc=$?
  [[ "$rc" == 10 || "$rc" == 13 ]] \
    && echo "claude-speak: daemon unit re-pointed at the installed version"

  # systemctl returns once the process is exec'd, but the daemon only accepts
  # on its socket after the model is mapped — a second or so. Without this,
  # the status block below asks in that gap and reports a daemon that is
  # starting perfectly well as "stopped". Two seconds at the outside, and
  # only on the run that actually restarted it.
  if [[ "$rc" == 13 ]]; then
    for _ in {1..10}; do
      "${SAY[@]}" --status >/dev/null 2>&1 && break
      sleep 0.2
    done
  fi

  cs_link_sync "$HOME/.local/bin" "$scripts"; rc=$?
  [[ "$rc" == 11 ]] && echo "claude-speak: $HOME/.local/bin/claude-speak re-pointed at the installed version"
  return 0
}

ensure_cfg() { "${CS[@]}" config ensure; }
set_key()    { "${CS[@]}" config set "$1" "$2"; }
get()        { "${CS[@]}" config get "$1"; }
held()       { "${CS[@]}" held "$@"; }

# Which project a play/clear/pending applies to. No argument means "the one
# this terminal is in" — the hook labels replies by the session's directory
# name, so the current directory identifies them. "all" means every project.
scope() {
  case "${1:-}" in
    all) printf '' ;;
    "")  basename "$PWD" ;;
    *)   printf '%s' "$1" ;;
  esac
}

waiting_by_project() { held labels; }

drop_played() { held drop "$1"; }   # empty label means every project

kokoro_ready() {
  [[ -x "$VENV_PY" && -f "$DATA/models/kokoro-v1.0.onnx" && -f "$DATA/models/voices-v1.0.bin" ]]
}

status() {
  "${CS[@]}" config summary
  if kokoro_ready; then
    printf 'engine:  kokoro (neural, local)\n'
  else
    printf 'engine:  system fallback — run "claude-speak install" for the neural voice\n'
  fi

  local unit daemon
  unit=$(systemctl --user is-active claude-speak.service 2>/dev/null)
  if "${SAY[@]}" --status >/dev/null 2>&1; then
    [[ "$unit" == "active" ]] && daemon="running (systemd)" || daemon="running (on demand)"
  else
    daemon="stopped — starts on the next reply"
  fi
  printf 'daemon:  %s\n' "$daemon"
}

ensure_cfg
heal

case "${1:-status}" in
  install) exec bash "$SCRIPTS/install.sh" "${@:2}" ;;

  on)   set_key enabled "true";  echo "claude-speak: on" ;;
  off)  set_key enabled "false"; "${SAY[@]}" --stop 2>/dev/null; echo "claude-speak: off" ;;
  stop) "${SAY[@]}" --stop 2>/dev/null; spd-say -C 2>/dev/null; pkill -x say 2>/dev/null
        echo "silenced" ;;

  voice)
    v="${2:?usage: claude-speak voice af_bella}"
    set_key voice "\"$v\""
    "${SAY[@]}" --voice "$v" --speed "$(get speed)" \
      "This is ${v//_/ }. I will read your replies in this voice from now on."
    ;;
  speed)
    set_key speed "${2:?usage: claude-speak speed 1.2}"; echo "speed: $2"
    "${SAY[@]}" --voice "$(get voice)" --speed "$2" "This is the new speaking speed."
    ;;
  max) set_key maxChars "${2:?usage: claude-speak max 4000}"; echo "maxChars: $2" ;;

  mode)
    m="${2:?usage: claude-speak mode queue|interrupt|drop}"
    case "$m" in queue|interrupt|drop) ;; *) echo "mode must be queue, interrupt or drop"; exit 2 ;; esac
    set_key multiSession "\"$m\""
    case "$m" in
      queue)     echo "mode: queue — other terminals wait their turn, announced by project" ;;
      interrupt) echo "mode: interrupt — the newest reply cuts off whatever is speaking" ;;
      drop)      echo "mode: drop — replies arriving mid-speech are skipped" ;;
    esac
    ;;

  queue) "${SAY[@]}" --status ;;

  hold)
    case "${2:-}" in
      on)  set_key holdReplies "true"
           echo "hold: on — replies are stashed and announced; play them with: claude-speak play" ;;
      off) set_key holdReplies "false"; echo "hold: off — replies are spoken as they finish" ;;
      *)   printf 'hold is %s\n' "$([ "$(get holdReplies)" = "true" ] && echo on || echo off)" ;;
    esac
    ;;

  guard)
    case "${2:-}" in
      on)  set_key meetingGuard "true"
           echo "meeting guard: on — nothing is spoken while your microphone is in use" ;;
      off) set_key meetingGuard "false"
           echo "meeting guard: off — replies may be spoken during calls" ;;
      test|"")
        if [[ "$(get meetingGuard)" != "true" ]]; then echo "meeting guard: off"; exit 0; fi
        apps=$(pactl list source-outputs 2>/dev/null \
               | grep -oP 'application\.name = "\K[^"]*' | sort -u | paste -sd', ')
        if [[ -n "$apps" ]]; then
          echo "meeting guard: on — ACTIVE, microphone in use by: $apps"
        else
          echo "meeting guard: on — idle, nothing is recording"
        fi
        ;;
      *) echo "usage: claude-speak guard [on|off|test]"; exit 2 ;;
    esac
    ;;

  sound)
    case "${2:-}" in
      "")  v=$(get holdSound); [[ -z "$v" || "$v" == "null" ]] && v="(system default)"; printf 'hold sound: %s\n' "$v" ;;
      off) set_key holdSound "off"; echo "hold sound: off — silent notification only" ;;
      default) set_key holdSound ""; echo "hold sound: system default" ;;
      *)
        [[ -f "$2" ]] || { echo "no such file: $2"; exit 2; }
        set_key holdSound "\"$2\""; echo "hold sound: $2"
        paplay "$2" 2>/dev/null || aplay -q "$2" 2>/dev/null
        ;;
    esac
    ;;

  pending)
    [[ -s "$HELD" ]] || { echo "nothing waiting"; exit 0; }
    here="$(basename "$PWD")"
    held pending "$here"
    total=$(held count)
    mine=$(held count "$here")
    printf '\n%s waiting, %s from this terminal (*)\n' "$total" "$mine"
    if [[ "$mine" == "0" ]]; then
      echo "  claude-speak play all        hear everything"
    elif [[ "$mine" != "$total" ]]; then
      echo "  claude-speak play            hear this terminal's $mine"
      echo "  claude-speak play all        hear all $total"
    fi
    ;;

  play)
    [[ -s "$HELD" ]] || { echo "nothing waiting"; exit 0; }
    want="$(scope "${2:-}")"

    n=$(held count "$want")
    if [[ "$n" == "0" ]]; then
      echo "nothing waiting for ${want}"
      echo "waiting elsewhere:"; waiting_by_project
      echo "hear everything with: claude-speak play all"
      exit 0
    fi

    # Oldest first, as ONE job so the daemon reads it straight through instead
    # of each entry cancelling the last. The project is named only when more
    # than one is being read — announcing a single one back to you is noise.
    text=$(held text "$want")

    drop_played "$want"
    "${SAY[@]}" --session held-playback --label "" \
      --voice "$(get voice)" --speed "$(get speed)" "$text"
    printf 'playing %s reply(ies)%s\n' "$n" "${want:+ from $want}"
    ;;

  clear)
    [[ -s "$HELD" ]] || { echo "nothing waiting"; exit 0; }
    want="$(scope "${2:-}")"
    n=$(held count "$want")
    [[ "$n" == "0" ]] && { echo "nothing waiting for ${want}"; exit 0; }
    drop_played "$want"
    printf 'discarded %s reply(ies)%s\n' "$n" "${want:+ from $want}"
    ;;

  voices)
    kokoro_ready || { echo "run 'claude-speak install' first"; exit 1; }
    "$VENV_PY" -c "
import sys; sys.path.insert(0, '$SCRIPTS')
import cspaths
from kokoro_onnx import Kokoro
print('\n'.join(sorted(Kokoro(cspaths.MODEL, cspaths.VOICES).get_voices())))" 2>/dev/null
    echo
    echo "Prefixes: a=American b=British e=Spanish f=French h=Hindi i=Italian j=Japanese p=Portuguese z=Chinese"
    echo "          f=female   m=male"
    ;;

  audition)
    kokoro_ready || { echo "run 'claude-speak install' first"; exit 1; }
    echo "Pick one afterwards with:  claude-speak voice <name>"
    "${SAY[@]}" --stop 2>/dev/null
    shift || true
    "$VENV_PY" "$SCRIPTS/audition.py" "$@" 2>/dev/null
    ;;

  read)
    f="${2:?usage: claude-speak read <file>   (- reads stdin)}"
    # Claude Code's @-completion inserts the path with an @ on the front, so
    # "/claude-speak:speak read @docs/x.md" arrives here literally. Strip it only when that
    # is what makes the path resolve, in case a file really is named @foo.
    [[ "$f" == @* && ! -e "$f" && -e "${f#@}" ]] && f="${f#@}"
    if [[ "$f" != "-" ]]; then
      [[ -e "$f" ]] || { echo "no such file: $f" >&2; exit 2; }
      [[ -f "$f" && -r "$f" ]] || { echo "not a readable file: $f" >&2; exit 2; }
    fi
    # Same markdown stripping the Stop hook uses, so a README sounds like prose
    # rather than punctuation. Refuses binary rather than reading it aloud.
    text=$(python3 "$SCRIPTS/cstext.py" "$f") || exit 1
    [[ -n "${text//[[:space:]]/}" ]] || { echo "nothing to read in $f"; exit 0; }

    speed=$(get speed)
    # ~14 characters a second at 1.0x — enough of an estimate to warn you before
    # a whole README starts talking. No cap: you asked for this file, not a
    # sample of it, and "claude-speak stop" ends it early.
    est=$(awk -v c="${#text}" -v s="$speed" 'BEGIN {
      t = int(c / (14 * (s > 0 ? s : 1)))
      if (t >= 60) printf "%dm%02ds", t / 60, t % 60; else printf "%ds", t
    }')
    # A fixed session id means a second "read" replaces the first instead of
    # queueing behind it, and piping sidesteps the argv limit on big files.
    printf '%s' "$text" | "${SAY[@]}" --session read-file --label "" \
      --voice "$(get voice)" --speed "$speed"
    printf 'reading %s — %s chars, about %s. Stop with: claude-speak stop\n' \
      "$([[ "$f" == "-" ]] && echo "stdin" || basename "$f")" "${#text}" "$est"
    ;;

  test)
    "${SAY[@]}" --voice "$(get voice)" --speed "$(get speed)" \
      "This is how Claude Code will sound when it reads a reply aloud. I fixed the import in parser dot pi, line forty two, and the tests pass."
    ;;

  restart)
    if systemctl --user restart claude-speak.service 2>/dev/null; then
      echo "daemon restarted"
    else
      pkill -f "$SCRIPTS/kokorod.py" 2>/dev/null
      echo "daemon stopped; it will start again on the next reply"
    fi
    ;;
  log)
    tail -n 30 "$DATA/daemon.log" 2>/dev/null
    journalctl --user -u claude-speak.service -n 20 --no-pager 2>/dev/null
    ;;

  status|"") status ;;
  # The header comment is the help text; stop at the first line that isn't one,
  # so adding a command never means fixing a line number here.
  -h|--help|help) awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$SELF" ;;
  *)
    echo "unknown option: $1"
    echo "valid: install on off stop status speed <n> voice <name> max <n> mode <m>"
    echo "       queue hold <on|off> guard <on|off|test> sound <file|off|default>"
    echo "       pending play [all|project] clear [all|project] read <file>"
    echo "       voices audition test restart log"
    exit 2
    ;;
esac
